# Configuration de production d'Ummati.
#
#   cp .env.example .env   puis remplir CHAQUE valeur marquée « À GÉNÉRER ».
#
# Le backend refuse de démarrer en profil prod tant qu'un secret est resté à la valeur
# par défaut du dépôt (cf. SecretsValidator) : une variable oubliée provoque un échec
# explicite, jamais un démarrage silencieux avec une clé publique.
#
# Ne committez JAMAIS le fichier .env — il est ignoré par git.
# Procédure de génération et de rotation : voir DEPLOIEMENT.md.

# ---------- URL publique ----------
# Sert à construire les liens des emails et à restreindre le CORS.
PUBLIC_URL=https://ummati.example.org
HTTP_PORT=80

# ---------- Base de données ----------
DB_NAME=ummati
DB_USER=ummati
# À GÉNÉRER : openssl rand -base64 24
DB_PASSWORD=

# ---------- Signature des jetons ----------
# À GÉNÉRER : openssl rand -hex 32
# Minimum 32 octets (HS256 = 256 bits). Le changer déconnecte tout le monde.
JWT_SECRET=

# ---------- Compte administrateur initial ----------
ADMIN_EMAIL=admin@ummati.example.org
# À GÉNÉRER : openssl rand -base64 18   (minimum 12 caractères)
ADMIN_PASSWORD=

# ---------- SMTP ----------
MAIL_HOST=smtp.example.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@ummati.example.org

# ---------- Notifications push (optionnel) ----------
# À GÉNÉRER : npx web-push generate-vapid-keys
# Laisser vide désactive uniquement les notifications push navigateur.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@ummati.example.org
