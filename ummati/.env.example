# ===== Ummati - Variables d'environnement =====
# Copiez ce fichier en .env et remplissez les valeurs

# Base de données PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/ummati
DB_USERNAME=ummati
DB_PASSWORD=

# JWT (secret ≥ 256 bits, générez-le avec: openssl rand -base64 64)
JWT_SECRET=

# Email SMTP
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@ummati.org

# Admin plateforme (seed initial)
ADMIN_EMAIL=admin@ummati.org
ADMIN_PASSWORD=

# Stockage fichiers
UPLOAD_DIR=./uploads

# URL de l'application
APP_BASE_URL=http://localhost:8080

# CORS (origines autorisées, séparées par des virgules)
CORS_ORIGINS=http://localhost:4200

# Notifications push navigateur (VAPID) — générez une paire avec:
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@ummati.org

